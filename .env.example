# FloodAid App - Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to version control

# Google Maps API Key - Get from Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenRouteService API Key - Get from https://openrouteservice.org/
EXPO_PUBLIC_OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Open-Meteo Weather API - Using FREE tier (no API key required)
# Endpoints are hardcoded in service files:
#   - Forecast: https://api.open-meteo.com/v1/forecast
#   - Archive: https://archive-api.open-meteo.com/v1/archive
#   - Flood: https://flood-api.open-meteo.com/v1/flood
# No configuration needed - all endpoints are free and public

# App Environment
NODE_ENV=development

# Backend ML API Configuration
# All platforms (iOS and Android) use the production Google Cloud Run deployment
# For local backend testing, configure ngrok URL in services/MLBackendService.js
API_BASE_URL=https://floodaid-backend-497410110873.asia-southeast1.run.app/api